# Atlas local environment template. Never commit this file with real values.

# First symbol analyzed by atlas (single-symbol mode)
ATLAS_DEFAULT_SYMBOL=BTC

# Public market data only; exchange order execution is hard-disabled.
ATLAS_CCXT_MODE=real
ATLAS_AUTO_TRADING_ENABLED=0
ATLAS_AUTO_TRADING_AUTO_ENABLE_WITH_KEYS=0

# Optional Telegram notifications: fill these locally, never commit real values.
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_CHAT_ID=

# Optional scanning controls. Full scan is not the default.
ATLAS_MAX_SYMBOLS=0
ATLAS_SCAN_INTERVAL_SECONDS=900
