# Atlas local environment template. Never commit this file with real values.

# First symbol analyzed by atlas (single-symbol mode)
ATLAS_DEFAULT_SYMBOL=BTC

# Public market data only; exchange order execution is hard-disabled.
ATLAS_CCXT_MODE=real
ATLAS_AUTO_TRADING_ENABLED=0
ATLAS_AUTO_TRADING_AUTO_ENABLE_WITH_KEYS=0

# Optional command-only Telegram group interface. No automatic signal notifications.
ATLAS_TELEGRAM_COMMANDS_ENABLED=0
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_CHAT_ID=

# Scanning controls. Zero scans the complete supported Gate.io USDT perpetual universe.
ATLAS_MAX_SYMBOLS=0
ATLAS_SCAN_INTERVAL_SECONDS=900

# Execution-cost model (rates are fractions per filled order leg).
# Replace with the fee rates shown in your own Gate.io account.
ATLAS_MAKER_FEE_RATE=0.0002
ATLAS_TAKER_FEE_RATE=0.00055
# One-way spread/slippage proxies; charged only on MARKET/STOP executions.
ATLAS_STOP_SPREAD_BUFFER_RATE=0.0002
ATLAS_STOP_SLIPPAGE_BUFFER_RATE=0.0003
