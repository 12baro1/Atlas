# Atlas local environment template. Never put real credentials in Git.
# Copy to .env locally and fill only values you actually use.

# Public market data / signal generation
ATLAS_CCXT_MODE=real
ATLAS_MAX_SYMBOLS=0

# Exchange order execution is intentionally unsupported/disabled in Atlas.
# Do not add live exchange API keys here.
ATLAS_AUTO_TRADING_ENABLED=0
ATLAS_AUTO_TRADING_AUTO_ENABLE_WITH_KEYS=0

# Optional Telegram delivery (fill locally; never commit real values)
ATLAS_TELEGRAM_BOT_TOKEN=
ATLAS_TELEGRAM_CHAT_ID=

# Optional analysis filters
ATLAS_TELEGRAM_MIN_CONFIDENCE=85
ATLAS_TELEGRAM_MIN_RR=3.0
ATLAS_TELEGRAM_REQUIRE_DECISION_ACTION=1
