[Unit]
Description=Atlas five-strategy + two-specialist market analysis
Documentation=https://github.com/12baro1/Atlas
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=5min
WatchdogSec=3min
WorkingDirectory=%h/Atlas
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/Atlas/.env
ExecStart=%h/Atlas/.venv/bin/python %h/Atlas/atlas_service.py
Restart=always
RestartSec=30
TimeoutStopSec=120
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=atlas

[Install]
WantedBy=default.target
